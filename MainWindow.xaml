<Window x:Class="WPF_Undervisning1_06._11.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Undervisning1_06._11"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <ListBox x:Name="ListBoxPizza" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,0,431,0" SelectionChanged="ListBoxPizza_SelectionChanged"/>
        <ListBox x:Name="ListBoxToppings" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="595,0,0,0"/>

    </Grid>
</Window>
